[Unit]
Description=ampdac UAC2 userspace transport
After=ampdac.socket
Requires=ampdac.socket
Before=mpd.service

[Service]
Environment=LD_LIBRARY_PATH=/usr/lib:/usr/lib/arm-linux-gnueabihf:/usr/lib/aarch64-linux-gnu:/lib:/lib/arm-linux-gnueabihf:/lib/aarch64-linux-gnu
ExecStart=/usr/bin/ampdacd
# Socket activation keeps systemd's mode. A self-bound socket is 0660;
# open it after the daemon creates or inherits /run/ampdac.sock.
ExecStartPost=/bin/sh -c 'i=0; while [ "$i" -lt 30 ]; do if [ -S /run/ampdac.sock ]; then chmod 666 /run/ampdac.sock; exit 0; fi; i=$((i+1)); sleep 0.1; done; exit 0'
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_ADMIN
NoNewPrivileges=true
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
